{
  "name": "hivemind-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "e2e": "playwright test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "sh -c 'if command -v bun >/dev/null 2>&1; then bun test; else node --experimental-strip-types --test test/*.test.ts; fi'",
    "test:bun": "bun test",
    "test:node": "node --experimental-strip-types --test test/*.test.ts",
    "demo": "sh dev/demo.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@fontsource/dejavu-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "dompurify": "^3.4.16",
    "katex": "^0.19.0",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
