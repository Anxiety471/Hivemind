{
  "name": "hivemind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import tsx src/cli.ts",
    "demo": "node --import tsx src/cli.ts --config examples/demo.json --task 'Write a short introduction to Hivemind'",
