/**
 * Message-block parity end to end (design §55). The zod-oracle guard
 * (`internal/messageblocks/blockschema_guard_test.go`) proves the parsers agree on one block in
 * memory; these cases prove the answer a stored block produces agrees through the whole crypto,
 * paging and output-validation path on `threads.get` and `threads.messages`.
 *
 * The blocks are the guard's own fixture (apps/api-go/internal/messageblocks/testdata/
 * message-blocks-schema.json, generated by apps/api-go/tools/blockschema-fixture.mts): the
 * all-fields sample of each kind the first guard run flagged, with its junk keys, plus one
 * malformed sample the fixture proves TypeScript refuses. A TS field added to a kind therefore
 * reaches these cases the moment the fixture is regenerated; a stale hand-written block cannot
 * narrow them.
 *
 * The malformed sample keeps the block's `kind` on purpose: an entry whose `kind` is not a string
 * is not a block at all, so readers on both sides drop it instead of failing the read. The
 * dropped-entry cases below pin that separate behaviour down.
 */
import { readFileSync } from "node:fs";
import type { Case, Seeded } from "./contract.mts";

type System = any;

type FixtureVariant = {
  kind: string;
  block: unknown;
  refusals: { why: string; block: unknown }[];
};

const fixture = JSON.parse(
  readFileSync(
    new URL("../internal/messageblocks/testdata/message-blocks-schema.json", import.meta.url),
    "utf8",
  ),
) as { variants: FixtureVariant[] };

/**
 * The kinds the guard's first run reported as diverging. Every one turned out to be a probe
 * artifact (the guard decoded numbers as float64 and re-derived zod's output instead of using
 * it), so these cases hold those kinds to the same bytes end to end: the endpoints the report
 * named as answering 500 are now proven equal by a real stored row, not only by the parser.
 */
const KINDS = [
  "ask",
  "voice_call",
  "call_request",
  "progress",
  "thinking",
  "steps",
  "job",
  "chart",
  "file",
  "app",
  "page",
  "handoff",
  "channel_message",
  "bot_message_received",
];

function variant(kind: string): FixtureVariant {
  const found = fixture.variants.find((candidate) => candidate.kind === kind);
  if (!found) throw new Error(`the block fixture has no ${kind} variant; regenerate it`);
  return found;
}

/** A block TypeScript refuses but that still names its kind, so the read fails instead of dropping it. */
function malformed(kind: string): unknown {
  const found = variant(kind).refusals.find(
    (refusal) => (refusal.block as { kind?: unknown } | null)?.kind === kind,
  );
  if (!found) throw new Error(`the block fixture has no malformed ${kind} sample that keeps its kind`);
  return found.block;
}

export function blockCases(system: System): Case[] {
  const id = (seeded: Seeded, key: string) => `${seeded.userId}-${key}`;
  const years = new Date(Date.UTC(2020, 0, 1));

  /** A bot and its thread, seeded under the case's own ids. */
  const thread = async (seeded: Seeded, key: string) => {
    await system.bot.create({
      data: {
        id: id(seeded, key),
        spaceId: seeded.spaces[0],
        userId: seeded.userId,
        name: `Block bot ${key}`,
        color: "blue",
        createdAt: years,
        updatedAt: years,
      },
    });
    await system.thread.create({
      data: {
        id: id(seeded, `${key}-thread`),
        spaceId: seeded.spaces[0],
        userId: seeded.userId,
        botId: id(seeded, key),
        nextMessageSeq: 500,
        nextEventSeq: 500,
      },
    });
  };

  const message = (seeded: Seeded, key: string, seq: number, blocks: unknown) =>
    system.message.create({
      data: {
        id: id(seeded, `${key}-m${seq}`),
        threadId: id(seeded, `${key}-thread`),
        seq,
        role: "bot",
        blocks,
        createdAt: new Date(Date.UTC(2020, 0, 1, 0, 0, seq)),
      },
    });

  const read = (
    name: string,
    procedure: "threads.get" | "threads.messages",
    key: string,
    seed: (seeded: Seeded) => Promise<void>,
    extra: Partial<Case> = {},
  ): Case => ({
    name,
    procedure,
    input: { botId: `__s-${key}__` },
    seed,
    // Every block kind here is served by Go: a 500 is Go's own output validation, never a proxy.
    declines: false,
    ...extra,
  });

  /** Every flagged kind with every field filled, in one thread. */
  const allFields = async (seeded: Seeded) => {
    await thread(seeded, "blkall");
    await Promise.all(
      KINDS.map((kind, seq) => message(seeded, "blkall", seq, [variant(kind).block])),
    );
  };

  /** One malformed block of `kind` in a thread of its own, so its failure is that block's. */
  const oneMalformed =
    (kind: string) =>
    async (seeded: Seeded) => {
      await thread(seeded, "blkbad");
      await message(seeded, "blkbad", 0, [malformed(kind)]);
    };

  /** A message whose list keeps a block beside entries no reader calls a block. */
  const dropped = async (seeded: Seeded) => {
    await thread(seeded, "blkdrop");
    await message(seeded, "blkdrop", 0, [
      { kind: 5, text: "kind is not a string" },
      null,
      ["not", "an", "object"],
      "not an object",
      { text: "no kind at all" },
      { kind: "text", text: "kept" },
    ]);
    await message(seeded, "blkdrop", 1, { kind: "text", text: "not a list" });
    await message(seeded, "blkdrop", 2, [{ kind: "text", text: "also kept" }]);
  };

  const cases: Case[] = [
    read("blk-all-fields-get", "threads.get", "blkall", allFields),
    read("blk-all-fields-messages", "threads.messages", "blkall", allFields),
  ];

  for (const kind of KINDS) {
    cases.push(read(`blk-malformed-${kind}-get`, "threads.get", "blkbad", oneMalformed(kind)));
    cases.push(
      read(`blk-malformed-${kind}-messages`, "threads.messages", "blkbad", oneMalformed(kind)),
    );
  }

  cases.push(read("blk-dropped-entries-get", "threads.get", "blkdrop", dropped));
  cases.push(read("blk-dropped-entries-messages", "threads.messages", "blkdrop", dropped));

  return cases;
}
