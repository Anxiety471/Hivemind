function className(error: Error): string {
  if (error instanceof ModelContentFilterError) return "content-filter";
  if (error instanceof TransientModelError) return "transient";
  if (error instanceof ModelOutputError) return "output";
  if (error instanceof ModelAccountError) return "account";
  return "server";
}

function decide(text: string, provider: string, requestLimitTooSmall: boolean) {
  // The fallback loop's rule: a placed failure switches to a backup; only a
  // transient failure, or an unexplained one with no status, retries the same
  // model once no backup is left.
  const placed =
    requestLimitTooSmall ||
    isRetryableProviderUnavailable(text) ||
    isModelCredentialRejected(text) ||
    isContentFilterRejection(text);
  if (!placed) {
    const unrecognized = unrecognizedModelFailure(text, provider);
    if (!unrecognized) return { switchToBackup: false, retrySameModel: false };
    return {
      switchToBackup: true,
      retrySameModel: isTransientModelError(text) || unrecognized.status === undefined,
    };
  }
  return { switchToBackup: true, retrySameModel: isTransientModelError(text) };
}

function row(
  text: string,
  provider: string,
  primaryProvider: string,
  failedAfterAccepting: boolean,
  requestLimitTooSmall: boolean,
) {
  const unrecognized = unrecognizedModelFailure(text, provider);
  const quotaResetAt = providerQuotaResetAt(text, NOW);
  const failure = modelFailure(text, text, { provider, primaryProvider, failedAfterAccepting });
  return {
    text,
    provider,
    primaryProvider,
    failedAfterAccepting,
    requestLimitTooSmall,
    class: className(failure),
    transient: isTransientModelError(text),
    providerUnavailable: isRetryableProviderUnavailable(text),
    credentialRejected: isModelCredentialRejected(text),
    contentFilter: isContentFilterRejection(text),
    permanent: namesPermanentModelFailure(text),
    status: modelErrorStatus(text) ?? null,
    unrecognized: unrecognized !== undefined,
    unrecognizedStatus: unrecognized?.status ?? null,
    computerAllowanceUsed: isComputerAllowanceUsed(text),
    quotaResetAt: quotaResetAt ?? null,
    ...decide(text, provider, requestLimitTooSmall),
  };
}

const rows: ReturnType<typeof row>[] = [];
for (const text of extractedMessages) {
  for (const provider of PROVIDERS) {
    rows.push(row(text, provider, provider, false, false));
  }
}

// Provider-specific branches the base rows cannot reach: a 400 the user's own
// endpoint refused, and a reply the endpoint accepted before failing.
const failedAfterAcceptingTexts = [
  '400 {"detail":"Bad Request"}',
  '400: {"message":"example upstream failure"}',
  '400: {"message":"Unsupported model example-model"}',
  "The model failed before writing a response.",
  "example:27b is a decision model and only supports /v1/example (ref: <ref-id>)",
];
for (const text of failedAfterAcceptingTexts) {
  for (const provider of ["openai-compatible", "local", "provider-a"]) {
    rows.push(row(text, provider, provider, true, false));
    rows.push(row(text, provider, provider, false, true));
  }
}

// Mixed fallback chains: primary failure plus failed and skipped backups.
const chains = [
  modelFallbackFailure("terminated", [
    {
      provider: "provider-a",
      modelId: "primary",
      status: "failed",
      reason: "Your account is out of credits.",
    },
    { provider: "opencode", modelId: "backup", status: "skipped", reason: "not configured" },
  ]),
  modelFallbackFailure(
    '400 data: {"error":{"code":"data_inspection_failed","param":null,"message":"Input text data may contain inappropriate content.","type":"data_inspection_failed"}}',
    [
      {
        provider: "local",
        modelId: "filtered",
        status: "failed",
        reason: '{"error":{"code":"content_filter"}}',
      },
      { provider: "provider-a", modelId: "other", status: "skipped", reason: "no key" },
    ],
  ),
  modelFallbackFailure("Provider returned an empty response", [
    { provider: "opencode", modelId: "empty", status: "failed", reason: "429 rate limit" },
  ]),
  modelFallbackFailure("something Rakazo has never seen", [
    { provider: "provider-a", modelId: "unknown", status: "failed", reason: "terminated" },
  ]),
  modelFallbackFailure("invalid_api_key: Incorrect API key provided", [
    { provider: "local", modelId: "local", status: "failed", reason: "context_length_exceeded" },
    {
      provider: "provider-a",
      modelId: "backup",
      status: "failed",
      reason: "Provider returned an empty response",
    },
  ]),
  modelFallbackFailure(
    "You have hit your ChatGPT usage limit (plus plan). Try again in ~158 min.",
    [{ provider: "provider-a", modelId: "primary", status: "skipped", reason: "skipped" }],
  ),
  modelFallbackFailure('500: {"message":"upstream exploded"}', [
    {
      provider: "provider-a",
      modelId: "backup",
      status: "failed",
      reason: '400: {"message":"Invalid effort level: max"}',
    },
  ]),
];
const chainProviders = [
  ["provider-a", "provider-a"],
  ["openai-compatible", "local"],
  ["local", "provider-a"],
  ["opencode", "openai-compatible"],
] as const;
for (const chain of chains) {
  for (const [provider, primaryProvider] of chainProviders) {
    rows.push(row(chain, provider, primaryProvider, false, false));
  }
}

writeFileSync(
  "internal/modelretry/testdata/corpus.json",
  `{"now":${NOW},"cases":[\n${rows.map((entry) => JSON.stringify(entry)).join(",\n")}\n]}\n`,
);
console.error(`wrote ${rows.length} cases`);
