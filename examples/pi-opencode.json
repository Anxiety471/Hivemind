{
  "maxAttempts": 3,
  "timeoutMs": 180000,
  "harnesses": {
    "pi-worker": { "type": "pi", "cwd": "." },
    "opencode-reviewer": { "type": "opencode", "agent": "plan", "cwd": "." }
  },
  "agents": [
    { "id": "developer", "role": "worker", "harness": "pi-worker", "description": "Implements and revises the task using Pi" },
    { "id": "reviewer", "role": "reviewer", "harness": "opencode-reviewer", "description": "Reviews the artifact and project files using OpenCode's plan agent" }
  ],
  "router": { "type": "rule" }
}
