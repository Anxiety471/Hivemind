{
  "maxAttempts": 3,
  "timeoutMs": 120000,
  "harnesses": {
    "decision-model": { "type": "openai-compatible", "baseUrl": "https://replace-with-provider.example/v1", "model": "replace-with-jev-model-id", "apiKeyEnv": "JEV_API_KEY" },
    "worker-model": { "type": "openai-compatible", "baseUrl": "https://replace-with-worker-provider.example/v1", "model": "replace-with-worker-model-id", "apiKeyEnv": "WORKER_API_KEY" },
    "cli-worker": { "type": "command", "command": "node", "args": ["--import", "tsx", "examples/command-worker.ts"] }
  },
  "agents": [
    { "id": "jev", "role": "router", "harness": "decision-model", "description": "Selects a worker or stops the workflow" },
    { "id": "developer", "role": "worker", "harness": "cli-worker", "description": "Command-backed worker (replace example wrapper with a real harness)" },
    { "id": "writer", "role": "worker", "harness": "worker-model", "description": "Model-backed drafting and reasoning" },
    { "id": "reviewer", "role": "reviewer", "harness": "worker-model", "description": "Reviews artifacts against the task" }
  ],
  "router": { "type": "model", "agent": "jev" }
}
